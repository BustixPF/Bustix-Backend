HOST=localhost
PORT=3000

# Database
DB_NAME=your_database_name
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# URL de conexión directa con Railway
DATABASE_URL=postgresql://your_database_username:your_database_password@your_database_host:your_database_port/your_database_name

# CLoudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT
JWT_SECRET=your_jwt_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

GOOGLE_CLIENT_ID=your.google.client.id
GOOGLE_CLIENT_SECRET=your.google.client.secret

# link de frontend y backend
FRONTEND_URL=your_frontend_url
BACKEND_URL=your_backend_url

# Mail / Nodemailer
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_FROM="your_name <your_email@example.com>"
MAIL_SECURE=false
